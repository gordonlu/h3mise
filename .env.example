# H3Mise environment configuration
# Copy to .env.local and adjust. Never commit .env files.

# RunningHub personal API key (v0.1 render backend)
RUNNINGHUB_API_KEY=

# Server port (default 4789)
PORT=4789

# Where H3Mise stores its registry + projects (default ~/.h3mise)
H3MISE_HOME=

# Optional built-in AI (OpenAI-compatible endpoint). Leave empty for AI-optional mode.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# v0.1 render backend: 'runninghub' (real, needs key) | 'mock' (offline synthetic renders)
H3MISE_PROVIDER=runninghub

# Serve the built web UI from :4789 when web/dist exists (default: on).
# Set to 0 for a pure-API server (e.g. while developing against Vite on :5173).
H3MISE_SERVE_WEB=
