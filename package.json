{
  "name": "h3mise",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first AI video directing workstation for story, shots, assets, continuity, takes, and timeline editing",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @h3mise/server --filter @h3mise/web dev",
    "dev:server": "pnpm --filter @h3mise/server dev",
    "dev:web": "pnpm --filter @h3mise/web dev",
    "launch": "node scripts/launch.mjs",
    "mcp": "node tools/h3mise-mcp.mjs",
    "h3mise": "node scripts/h3mise.mjs",
    "build": "pnpm -r build",
    "start": "pnpm --filter @h3mise/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test scripts/launch.test.mjs scripts/h3mise-cli.test.mjs && pnpm --filter @h3mise/server test",
    "test:agent": "node --test scripts/h3mise-api.test.mjs scripts/h3mise-mcp.test.mjs && node --import ./server/node_modules/tsx/dist/loader.mjs --test web/test/studio-performance.test.ts",
    "test:smoke": "node scripts/smoke-production.mjs"
  }
}
